# Frontend build output (regenerated by `bench build --app hospitality_pms`)
hospitality_pms/public/frontend/
hospitality_pms/www/pms.html

# `bench build` symlinks the app's node_modules into the public folder so Vite can
# resolve them. It is a build artefact pointing at an absolute path on one machine,
# and the `node_modules/` rule above does not catch it because a symlink is not a
# directory - which is how it reached a commit once already.
hospitality_pms/public/node_modules
